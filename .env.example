# Copy to .env and fill in. .env is gitignored and never committed.

# Required for the real model (not needed for `store-assistant --demo` or the tests).
ANTHROPIC_API_KEY=

# Model via PydanticAI's "provider:model" string. Haiku 5.5 is the cheap switch.
LLM_MODEL=anthropic:claude-opus-5-5
# SUMMARY_MODEL=anthropic:claude-haiku-5-5
LLM_EFFORT=medium

# Optional: send traces to Logfire (https://logfire.pydantic.dev). Leave empty to run offline.
LOGFIRE_TOKEN=

# Conversation rules
STORE_PASSPHRASE=open sesame
PASSPHRASE_MAX_ATTEMPTS=3
REQUIRE_PASSPHRASE_PER_LOOKUP=false
OFF_TOPIC_STRIKE_LIMIT=3
DEFAULT_PHONE_REGION=US
MAX_STORE_NAME_LENGTH=80

# Storage
DB_PATH=store_assistant.db

# Spend guardrails (apply no matter whose key is used)
MAX_TURNS_PER_SESSION=40
MAX_REQUESTS_PER_SESSION=80
MAX_TOKENS_PER_SESSION=500000
MAX_OUTPUT_TOKENS=1024
SESSION_COST_LIMIT_USD=0.50
DAILY_COST_LIMIT_USD=5.00
PROMPT_CACHING=true
REFUSAL_FALLBACK=true
# FALLBACK_MODEL=anthropic:claude-opus-4-8
MAX_CONSECUTIVE_MODEL_ERRORS=3
